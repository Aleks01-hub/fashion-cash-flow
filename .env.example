# Copy to .env and replace all example values with strong, unique secrets.
DATABASE_PASSWORD=replace_with_a_strong_mysql_user_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_strong_root_password
MYSQL_PORT=3306
# Used only when the database has no users yet. Choose a strong password.
INITIAL_ADMIN_PASSWORD=replace_with_a_strong_admin_password
# Frontend local development; the app API client may use VITE_API_URL.
VITE_API_URL=http://localhost:8080
VITE_API_BASE_URL=http://localhost:8080
